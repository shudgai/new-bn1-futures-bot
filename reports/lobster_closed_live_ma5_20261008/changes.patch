+import asyncio
+import copy
+import json
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+
+import pandas as pd
+import pytest
+
+from core.services.entry_contract import (
+    closed_ma5_direction_evidence, evaluate_entry_contract, live_breakout_ma5_evidence,
+)
+from core.services.entry_firewall import validate_account_entry
+from test_entry_chop_gate import eligible_frame, authority_code
+from test_cap_pair_continuation import account, observe, advance
+
+BLOCK = 'BLOCKED_CLOSED_MA5_FLAT_OPPOSITE_OR_INVALID'
+
+
+def recorded_frame():
+    data = json.loads((Path(__file__).parent/'fixtures/lobster_20261008_141723.json').read_text())
+    rows = [dict(row, is_closed=True) for row in data['candles']]
+    rows.append(dict(data['live_candle'], is_closed=False))
+    f = pd.DataFrame(rows)
+    f.attrs['timeframe_ms'] = 60000
+    return data, f
+
+
+@pytest.mark.parametrize('side', ['LONG', 'SHORT'])
+def test_exact_recorded_entry_is_blocked_despite_live_ma5_direction(side):
+    data, f = recorded_frame()
+    quote = data['quote']
+    if side == 'LONG':
+        original = f.copy()
+        for key, source in [('open', 'open'), ('close', 'close'), ('high', 'low'),
+                            ('low', 'high'), ('ma3', 'ma3'), ('ma5', 'ma5'),
+                            ('ma15', 'ma15'), ('kc_middle', 'kc_middle'),
+                            ('kc_upper', 'kc_lower'), ('kc_lower', 'kc_upper')]:
+            f[key] = .08-original[source]
+        quote = .08-quote
+    assert live_breakout_ma5_evidence(f, quote, side)
+    diagnostics = {}
+    assert evaluate_entry_contract(f, quote, 'KC_LIVE_BODY_BREAKOUT_'+side,
+                                   symbol='龙虾/USDT', diagnostics=diagnostics) is None
+    assert diagnostics['reason'] == BLOCK
+
+
+@pytest.mark.parametrize('side', ['LONG', 'SHORT'])
+@pytest.mark.parametrize('kind', ['live', 'pair', 'pivot'])
+@pytest.mark.parametrize('fault', ['opposite', 'flat', 'nan', 'negative'])
+def test_every_lobster_authority_rejects_wrong_closed_direction(side, kind, fault):
+    f = eligible_frame(kind, side)
+    code = authority_code(kind, side)
+    assert evaluate_entry_contract(f, code=code, symbol='龙虾/USDT')
+    current = float(f.iloc[-2].ma5)
+    sign = 1 if side == 'LONG' else -1
+    if fault == 'opposite':
+        f.loc[f.index[-3], 'ma5'] = current+sign*.1
+    elif fault == 'flat':
+        f.loc[f.index[-3], 'ma5'] = current
+    else:
+        f.loc[f.index[-3], 'ma5'] = float('nan') if fault == 'nan' else -1.
+    diagnostics = {}
+    assert closed_ma5_direction_evidence(f, side) is None
+    assert evaluate_entry_contract(f, code=code, symbol='龙虾/USDT', diagnostics=diagnostics) is None
+    if kind == 'live':
+        assert diagnostics['reason'] == BLOCK
+    else:
+        # Pair/pivot formation already rejects invalid or opposite completed
+        # MA5 before the common final gate; neither may bypass that rejection.
+        assert diagnostics['reason'] in (BLOCK, 'WAIT_NEW_KC_BREAKOUT',
+            'WAIT_VALID_KC_PENDING_DATA', 'WAIT_SUSTAINED_OUTER_RUN_PIVOT_RETURN')
+
+
+@pytest.mark.parametrize('side', ['LONG', 'SHORT'])
+@pytest.mark.parametrize('continuation', [False, True])
+def test_cap_pair_and_observed_continuation_share_closed_gate(side, continuation, monkeypatch):
+    a = account()
+    f = eligible_frame('pair', side)
+    observe(a, f, monkeypatch)
+    if continuation:
+        f = advance(a, f, monkeypatch)
+    decision = evaluate_entry_contract(f, account=a, symbol='CAP/USDT')
+    assert decision
+    sign = 1 if side == 'LONG' else -1
+    f.loc[f.index[-3], 'ma5'] = float(f.iloc[-2].ma5)+sign*.1
+    diagnostics = {}
+    assert evaluate_entry_contract(f, code=decision['type'], account=a,
+                                   symbol='CAP/USDT', diagnostics=diagnostics) is None
+    assert closed_ma5_direction_evidence(f, side) is None
+    assert diagnostics['reason'] in (BLOCK, 'WAIT_NEW_KC_BREAKOUT')
+
+
+@pytest.mark.parametrize('side', ['LONG', 'SHORT'])
+def test_final_firewall_revokes_cached_permission_when_closed_direction_changes(side, monkeypatch):
+    f = eligible_frame('live', side)
+    symbol = '龙虾/USDT'
+    now = float(f.iloc[-1].timestamp)+1000
+    monkeypatch.setattr('time.time', lambda: now/1000)
+    f.attrs.update(entry_finality_verified=True, entry_finality_server_ms=now)
+    a = SimpleNamespace(positions={}, position_meta={}, pending_limit_orders={}, trades=[],
+                        last_closed_at={}, channel_profit_reentries={}, save_state=Mock(),
+                        log=Mock(), entry_frame_provider=AsyncMock(return_value=f))
+    d = evaluate_entry_contract(f, symbol=symbol)
+    assert d
+    context = dict(entry_signal_code=d['type'], channel_confirmation_bar_id=d['confirmation_bar_id'])
+    asyncio.run(validate_account_entry(a, symbol, side, context))
+    prior = copy.deepcopy(context['entry_snapshot'])
+    assert prior['entry_latest_closed_ma5'] != prior['entry_previous_closed_ma5']
+    sign = 1 if side == 'LONG' else -1
+    f.loc[f.index[-3], 'ma5'] = float(f.iloc[-2].ma5)+sign*.1
+    with pytest.raises(ValueError, match=BLOCK):
+        asyncio.run(validate_account_entry(a, symbol, side, context))
+    assert not a.position_meta.get('_entry_gate_halts')
+
+
+@pytest.mark.parametrize('side', ['LONG', 'SHORT'])
+def test_live_frame_ma5_cannot_substitute_for_completed_direction(side):
+    f = eligible_frame('live', side)
+    expected = closed_ma5_direction_evidence(f, side)
+    assert expected
+    f.loc[f.index[-1], 'ma5'] = float('nan')
+    assert closed_ma5_direction_evidence(f, side) == expected
+
+
+@pytest.mark.parametrize('side', ['LONG', 'SHORT'])
+def test_floating_point_noise_is_not_closed_ma5_direction(side):
+    f = eligible_frame('live', side)
+    sign = 1 if side == 'LONG' else -1
+    current = float(f.iloc[-2].ma5)
+    f.loc[f.index[-3], 'ma5'] = current-sign*current*1e-13
+    assert closed_ma5_direction_evidence(f, side) is None
