+import asyncio
+import copy
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+
+import pandas as pd
+import pytest
+
+from core.services.exits.hard_stop_service import enforce_hard_stop, hard_stop_reason
+from core.services.exits.entry_atr_protection import enforce_atr_protection
+from core.services.exits.peak_trailing_exit import STATE_KEY, evaluate_peak_trailing
+from core.services.exits.realtime_profit_exit import cached_tick_indicators, enforce_realtime_profit_exit
+from core.services.exits.structural_holding_exit import POLICY, REASON, MA5_EXIT
+
+SYMBOLS = ['龙虾/USDT', 'CAP/USDT']
+SIDES = ['LONG', 'SHORT']
+
+
+def position(side, symbol):
+    return dict(side=side, symbol=symbol, entry_price=100., qty=1., entry_atr=1.,
+                entry_mode='CHANNEL_SWING', open_timestamp=60., margin=1., leverage=100.)
+
+
+def frame(kind, side):
+    lows = [98., 97., 98., 99., 96.] if kind == 'structure' else [98.]*5
+    highs = [102., 102., 102., 104., 103.] if kind == 'pivot' else [102.]*5
+    closes = [100.]*5
+    if kind == 'structure':
+        closes[-1] = 96.5
+    rows = [dict(timestamp=(i+1)*60000., open=100., high=highs[i], low=lows[i],
+                 close=closes[i], ma5=100., ma3=100., ma15=100., atr=1.,
+                 kc_upper=101., kc_middle=100., kc_lower=99., is_closed=True)
+            for i in range(5)]
+    rows.append(dict(rows[-1], timestamp=360000., open=100., high=102., low=98.,
+                     close=100., is_closed=False))
+    f = pd.DataFrame(rows)
+    if side == 'SHORT':
+        old = f.copy()
+        for key, source in [('open', 'open'), ('close', 'close'), ('high', 'low'),
+                            ('low', 'high'), ('kc_lower', 'kc_upper'), ('kc_upper', 'kc_lower')]:
+            f[key] = 200.-old[source]
+    return f
+
+
+def snapshot(kind, side):
+    return cached_tick_indicators(frame(kind, side), 100., 361000.)[0]
+
+
+@pytest.mark.parametrize('symbol', SYMBOLS)
+@pytest.mark.parametrize('side', SIDES)
+@pytest.mark.parametrize('kind,reason', [('pivot', MA5_EXIT), ('structure', REASON)])
+def test_confirmed_exit_without_profit_ma_or_entry_gate(symbol, side, kind, reason):
+    p = position(side, symbol)
+    s = snapshot(kind, side)
+    s.update(ma5=float('nan'), ma15=float('nan'))
+    decision = evaluate_peak_trailing(p, 100., s)
+    assert decision and decision['reason'] == reason
+    assert p[STATE_KEY]['holding_exit_policy'] == POLICY
+    assert decision['price'] == 100.
+
+
+@pytest.mark.parametrize('symbol', SYMBOLS)
+@pytest.mark.parametrize('side', SIDES)
+def test_deep_loss_waterfall_and_initial_profit_do_not_close(symbol, side):
+    p = position(side, symbol)
+    sign = 1 if side == 'LONG' else -1
+    p.update(initial_sl=100-sign*.1,
+             entry_snapshot={'signal_code': 'KC_LIVE_CROSS_'+side})
+    s = snapshot('none', side)
+    s['live_open'] = 100+sign*10.
+    assert hard_stop_reason(p, 100-sign*30.) is None
+    assert evaluate_peak_trailing(p, 100-sign*30., s) is None
+    p['open_timestamp'] = 360.
+    assert evaluate_peak_trailing(p, 100+sign*.5, s) is None
+
+
+@pytest.mark.parametrize('side', SIDES)
+@pytest.mark.parametrize('cause', ['INITIAL_ATR', 'MARGIN_LOSS', 'PRICE_LOSS'])
+def test_old_hard_stop_is_cleared_from_position_and_metadata(side, cause):
+    p = position(side, 'CAP/USDT')
+    p['channel_hard_stop_pending'] = cause
+    p[STATE_KEY] = dict(pending='EXIT_ACCOUNT_HARD_STOP', trigger=cause)
+    meta = copy.deepcopy(p)
+    a = SimpleNamespace(positions={'CAP/USDT': p}, position_meta={'CAP/USDT': meta},
+                        save_state=Mock(), close_position=AsyncMock())
+    assert not asyncio.run(enforce_hard_stop(a, 'CAP/USDT', 50.))
+    for source in (p, meta):
+        assert 'channel_hard_stop_pending' not in source
+        assert 'pending' not in source[STATE_KEY]
+    a.close_position.assert_not_awaited()
+    a.save_state.assert_called_once()
+
+
+@pytest.mark.parametrize('side', SIDES)
+def test_other_entry_modes_retain_their_account_limits(side):
+    p = position(side, 'CAP/USDT')
+    p['entry_mode'] = 'PIVOT_TURN'
+    sign = 1 if side == 'LONG' else -1
+    assert hard_stop_reason(p, 100-sign*30.) == 'MARGIN_LOSS'
+
+
+@pytest.mark.parametrize('kind', ['pivot', 'structure'])
+@pytest.mark.parametrize('side', SIDES)
+@pytest.mark.parametrize('fault', ['preentry', 'stale', 'fallback', 'unconfirmed', 'invalid'])
+def test_unverified_or_preentry_formation_holds(kind, side, fault):
+    p = position(side, 'CAP/USDT')
+    s = snapshot(kind, side)
+    if fault == 'preentry':
+        p['open_timestamp'] = 301.
+    elif fault == 'stale':
+        s['closed_bar_ms'] = 240000.
+    elif fault == 'fallback':
+        s['fallback_used'] = True
+    elif kind == 'pivot':
+        rows = s['pivot_exit_history']
+        if fault == 'unconfirmed':
+            key = 'high' if side == 'LONG' else 'low'
+            rows[-1][key] = rows[-2][key]
+        else:
