# ====== 【改進方案】波動率篩選 ======
# ⚠️ 允許 0.10%~0.55% 波動；MA7 入口可依近 6 小時環境動態放寬至 0.06%
# ⚠️ 低波動幣用 Trailing SL 補充保護
MIN_ATR_PCT=0.0010
MAX_ATR_PCT=0.0055

# ====== 【改進方案】入場品質門檻 ======
# 恢復 75 分與 Quality+5，避免低品質訊號只靠基礎分數進場。
MIN_SCORE_THRESHOLD=75
MIN_OPEN_SIGNAL_SCORE=75
STRONG_BREAKOUT_SCORE_THRESHOLD=78
ENTRY_MIN_QUALITY_BONUS=5

# ====== 【改進方案】ADX 動能檢查 ======
# ⚠️ ADX_QUALITY_MIN=12 降低 3 分（從 15），放寬品質檢查
# ⚠️ WEAK_ENERGY_ADX_THRESHOLD=22 降低 3 分（從 25），只限制極弱動能的槓桿
# ⚠️ 這樣：ADX 12~21 能開倉但低槓桿；ADX < 12 直接擋
ADX_QUALITY_MIN=12
ADX_MANDATORY_MIN=10.0
WEAK_ENERGY_ADX_THRESHOLD=22
WEAK_ENERGY_LEVERAGE_CAP=2
ADX_DECLINE_LOOKBACK_BARS=4

# ====== 【改進方案】出場參數 ======
# 啟用 Trailing SL，主動跟著行情調整止損
ENABLE_TRAILING_SL=false
ENABLE_TRAILING_STOP=true
TRAILING_SL_ATR_MULT=3.0
EARLY_PROFIT_GUARD_TRIGGER_PCT=0.003
EARLY_PROFIT_GUARD_EXIT_PCT=0.002
# 啟用趨勢追蹤出場，不只靠止損
ENABLE_TREND_FOLLOW_EXIT=false
ENABLE_STRONG_TRIGGER_AUTO_CLOSE=false
TRAILING_TRIGGER_PCT=0.0025
TRAILING_CALLBACK_PCT=0.0005
CONTRARIAN_TRAILING_TRIGGER_PCT=0.0025
TRAILING_TIER1_TRIGGER_ATR_MULT=2.5
TRAILING_TIER2_TRIGGER_ATR_MULT=4.5
TRAILING_TIER3_TRIGGER_ATR_MULT=6.0


# ====== 其他關鍵參數 ======
KELTNER_ATR_MULTIPLIER=1.5
KELTNER_MIN_VOLUME_RATIO=0.8
