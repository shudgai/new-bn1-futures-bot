PORT=8006
PAPER_TRADING=true
INITIAL_BALANCE=10000.0
LEVERAGE=5
MAX_SLOTS=5
TRADE_AMOUNT_USDT=50.0
MAX_TRADE_RISK_USDT=0.50
BINANCE_API_KEY=""
BINANCE_SECRET=""

# 正式上線當天才改為 false（並確認上面已換成正式帳戶金鑰）
USE_TESTNET=true

BTC_REGIME_FILTER_ENABLED=false
BTC_REGIME_ALLOW_CONTRARY=false

# 每日虧損達帳戶餘額此比例（%）就暫停開新倉，既有持倉仍正常出場
MAX_DAILY_LOSS_PCT=10.0

# Email 警報（重大事件用 SMTP 寄信通知）
# 若用 Gmail：SMTP_USER 是寄件帳號，SMTP_PASSWORD 要用 Google 帳號的
# 「應用程式密碼」(App Password)，不是登入密碼；需先在 Google 帳號開啟兩步驟驗證。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
ALERT_EMAIL_TO=shudgai999@gmail.com

# 是否完全停用初始止盈保護單 (Take Profit)，交由移動止利 (Trailing Stop) 跑大行情
DISABLE_TAKE_PROFIT=true

# 是否在交易所掛初始虧損停損單；false 時由本地監控，達最大允許虧損才平倉
ENABLE_EXCHANGE_INITIAL_STOP_LOSS=true
MAX_ACCEPTABLE_LOSS_PCT=0
DISASTER_STOP_MULTIPLIER=1.0
MIN_NET_REWARD_RISK=2.0
NET_PROFIT_GUARANTEE_BUFFER=0.006
TRAILING_TIER2_LOCK_ATR_MULT=2.0

# 是否開啟大週期 (15m) EMA20 收線確認趨勢移動止損
ENABLE_TREND_FOLLOW_EXIT=false

# 是否開啟雙重防線失守（均線 X ＋ 結構 ⛔）自動平倉機制
ENABLE_STRONG_TRIGGER_AUTO_CLOSE=false
MA7_EXIT_MIN_HOLD_SEC=600
MA7_EXIT_MIN_ADVERSE_PCT=0.002
MA7_EXIT_MIN_ADVERSE_ATR_MULT=0.5

# MA7 僅採用已收盤、峰谷後連續兩根確認；盤中投影預設停用以避免假轉彎。
MA7_EARLY_ENTRY_ENABLED=false
MA7_EARLY_MIN_ATR_MULT=0.05
MA7_REVERSAL_MIN_ATR_MULT=0.10
# 停用高風險/負期望幣種（FARTCOIN=迷因幣, PENGU=高波動損失大）
ENTRY_DISABLED_SYMBOLS=FARTCOIN/USDT,PENGU/USDT,ENA/USDT
MA7_FAST_MIN_ATR_MULT=0.02
MA7_FAST_MAX_ATR_MULT=0.20
MA7_FAST_MIN_VOLUME_RATIO=1.5
MA7_BOTTOM_ENTRY_ENABLED=false
MIN_SCORE_THRESHOLD=75
MIN_OPEN_SIGNAL_SCORE=75

# 是否開啟移動停損（隨價格有利方向移動，止損線只進不退）
ENABLE_TRAILING_SL=false
ENABLE_TRAILING_STOP=true
# 止損線距離動態 ATR 倍數（預設 3.0 倍 ATR）
TRAILING_SL_ATR_MULT=3.0
EARLY_PROFIT_GUARD_TRIGGER_PCT=0.003
EARLY_PROFIT_GUARD_EXIT_PCT=0.002
# 移動停利門檻：無槓桿浮盈達 0.25% 啟動鎖利，回吐 0.05% 平倉
TRAILING_TRIGGER_PCT=0.0025
TRAILING_CALLBACK_PCT=0.0005
CONTRARIAN_TRAILING_TRIGGER_PCT=0.0025

# 無 MA7 結構化進出場
STRUCTURED_ENTRY_ENABLED=true
STRUCTURED_VOLUME_MIN_RATIO=1.0
STRUCTURED_SUPPORT_ORDER_TIMEOUT_SEC=300
BREAKOUT_HARD_STOP_ATR_MULT=1.0
BREAKOUT_TRAILING_ATR_MULT=1.75
BREAKOUT_RR1_TARGET=1.5
BREAKOUT_RR2_TARGET=2.5
BREAKOUT_RR_CLOSE_FRACTION=0.5
STRUCTURED_EXIT_INTERVAL_SEC=15
