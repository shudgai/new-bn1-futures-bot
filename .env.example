# ====== 【改進方案】波動率篩選 ======
# ⚠️ 允許 0.10%~0.55% 波動；MA5 入口可依近 6 小時環境動態放寬至 0.06%
# ⚠️ 低波動幣用 Trailing SL 補充保護
MIN_ATR_PCT=0.0005
MAX_ATR_PCT=0.0040

# ====== 【改進方案】入場品質門檻 ======
# 恢復 75 分與 Quality+5，避免低品質訊號只靠基礎分數進場。
MIN_SCORE_THRESHOLD=75
MIN_OPEN_SIGNAL_SCORE=60
STRONG_BREAKOUT_SCORE_THRESHOLD=78
ENTRY_MIN_QUALITY_BONUS=3

# ====== 【改進方案】ADX 動能檢查 ======
# ⚠️ ADX_QUALITY_MIN=20 降低 3 分（從 15），放寬品質檢查
# ⚠️ WEAK_ENERGY_ADX_THRESHOLD=22 降低 3 分（從 25），只限制極弱動能的槓桿
# ⚠️ 這樣：ADX 12~21 能開倉但低槓桿；ADX < 12 直接擋
ADX_QUALITY_MIN=25
ADX_MANDATORY_MIN=25.0
ADX_STRONG_TREND_MIN=10.0
WEAK_ENERGY_ADX_THRESHOLD=22
WEAK_ENERGY_LEVERAGE_CAP=2
ADX_DECLINE_LOOKBACK_BARS=4

# ====== 【改進方案】出場參數 ======
# 啟用 Trailing SL，主動跟著行情調整止損
ENABLE_TRAILING_SL=true
ENABLE_TRAILING_STOP=false
# 單階段固定鎖利：無槓桿浮盈達 0.5% 時，一次將保護線鎖到 0.5%。
# 不啟用百分比階梯或 R 制移動停利，避免多套獲利出場互相覆蓋。
